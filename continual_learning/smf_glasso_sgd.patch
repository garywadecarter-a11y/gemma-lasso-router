     def _make_grad_hook(self, layer_idx: int):
         def hook(grad):
             mask = self.slot_train_masks[layer_idx].to(grad.device)
-            return grad * mask.unsqueeze(-1).to(grad.dtype)
+            if self.config.scoring != "glasso":
+                return grad * mask.unsqueeze(-1).to(grad.dtype)
+            # Weighted group lasso (closed form, one group per value row):
+            #   u_i = g_i * max(0, 1 - lam * w_i * gbar / ||g_i||)
+            # w_i  = background usage of slot i, normalised to mean 1 (interference cost)
+            # gbar = mean grad norm over rows accessed in this batch (makes lam scale-free)
+            g32 = grad.float()
+            gn = g32.norm(dim=-1)
+            if not bool(mask.any()):
+                return grad * 0
+            gbar = gn[mask].mean().clamp_min(1e-12)
+            bg = self.bg_access_counts[layer_idx].to(grad.device).float() + 1.0
+            w = bg / bg.mean()
+            mult = (1.0 - self.config.lam * w * gbar / gn.clamp_min(1e-12)).clamp_min(0.0) * mask.float()
+            self.last_rows_updated[layer_idx] = int((mult > 0).sum().item())
+            return (g32 * mult.unsqueeze(-1)).to(grad.dtype)
 
         return hook
 
